# BioAge-X Environment Configuration Template
PROJECT_NAME="BioAge-X"
API_V1_STR="/api/v1"
SECRET_KEY="replace-with-a-secure-random-secret-in-production"

# Database connection
# Default SQLite:
DATABASE_URL="sqlite:///./data/bioage_platform.db"
# PostgreSQL Production Example:
# DATABASE_URL="postgresql://bioage_user:bioage_password@localhost:5432/bioage_db"

# Server Host and Port
API_HOST="127.0.0.1"
API_PORT="8000"

# Frontend API URL
NEXT_PUBLIC_API_URL="http://127.0.0.1:8000/api/v1"

# ==============================================================================
# External Biological Knowledge Integration Layer (Optional / Fallback Enabled)
# ==============================================================================
# When unset or offline, BioAge-X automatically utilizes cryptographic local caching
# and curated offline interactome fallbacks without interruption.
ENABLE_LIVE_INTEGRATIONS="true"
INTEGRATIONS_TIMEOUT_SECONDS=10
INTEGRATIONS_CACHE_TTL_DAYS=30

# NCBI / GEO E-Utilities Configuration
# Optional: Register at NCBI for higher request limits (10 req/s instead of 3 req/s)
# NCBI_API_KEY="your-ncbi-api-key-here"

# STRING DB Configuration
# Optional: Custom application identifier passed to STRING API
# STRING_CALLER_IDENTITY="BioAge-X-Research"

# CI / Test Runner Flags
# Set to "true" to run live HTTP health check tests; default "false" ensures deterministic offline CI
RUN_LIVE_INTEGRATION_TESTS="false"
