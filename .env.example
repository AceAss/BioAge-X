# BioAge-X Environment Configuration Template
PROJECT_NAME="BioAge-X"
API_V1_STR="/api/v1"
SECRET_KEY="replace-with-a-secure-random-secret-in-production"

# Database connection
# Default SQLite:
DATABASE_URL="sqlite:///./data/bioage_platform.db"
# PostgreSQL Production Example:
# DATABASE_URL="postgresql://bioage_user:bioage_password@localhost:5432/bioage_db"

# Server Host and Port
API_HOST="127.0.0.1"
API_PORT="8000"

# Frontend API URL
NEXT_PUBLIC_API_URL="http://127.0.0.1:8000/api/v1"
