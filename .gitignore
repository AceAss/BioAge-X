# =============================================================================
# BioAge-X .gitignore
# =============================================================================

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
/lib/
/lib64/
!apps/frontend/src/lib/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments
.env
.env.*
!.env.example
.venv/
venv/
env/
ENV/

# Pytest / Coverage / Type checkers
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.xml

# Jupyter
.ipynb_checkpoints/

# Node / Next.js
apps/frontend/node_modules/
apps/frontend/.next/
apps/frontend/out/
apps/frontend/dist/
apps/frontend/build/
apps/frontend/coverage/
apps/frontend/.pnp
apps/frontend/.pnp.js

# Local database
*.db
*.sqlite
*.sqlite3
data/bioage_platform.db

# ML experiment tracking
mlruns/
mlartifacts/

# Generated ML model weights (large binary artifacts)
data/processed/*.joblib
data/processed/*.pt
data/processed/*.pth
data/processed/*.ckpt

# Generated PDF reports (reproducible via pipeline)
data/processed/*.pdf

# Large raw / downloaded data — use scripts to generate/download
data/raw/
!data/raw/.gitkeep

# Provenance records (local session data, not required for reproducibility)
data/cache/provenance/

# NOTE: data/cache/integrations/ small JSON files ARE committed intentionally
# They serve as deterministic local fallback data for offline CI and reproducibility.

# Large generated demo CSV (generated by scripts/generate_demo_data.py)
data/example/demo_*.csv

# IDE
.vscode/
.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# OS
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# Logs and temp files
*.log
logs/
tmp/
temp/

# Archives
*.zip
*.tar.gz
*.tar.bz2
*.tar.xz

# Cache integration responses (generated at runtime, not required for reproducibility)
data/cache/integrations/ensembl/
data/cache/integrations/geo/
data/cache/integrations/reactome/
data/cache/integrations/string/
!data/cache/integrations/.gitkeep
!data/cache/.gitkeep
!data/processed/.gitkeep

